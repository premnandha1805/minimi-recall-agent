{
  "name": "minimi-recall-agent",
  "version": "1.0.0",
  "description": "Temporal, evidence-grounded chat agent with fast web search and citation verification",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --ignore ./.data/** --ignore ./.recall-data/** src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:browser",
    "typecheck:server": "tsc --noEmit",
    "typecheck:browser": "tsc --ignoreConfig --noEmit --allowJs --checkJs --strict --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck public/api.js public/app.js",
    "test": "vitest run",
    "lint": "node scripts/lint.mjs",
    "test:live": "tsx scripts/live-e2e.ts",
    "eval:offline": "node scripts/evaluate-offline.mjs",
    "eval:memory": "node scripts/evaluate-memory.mjs",
    "smoke:tavily": "tsx scripts/tavily-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "24.11.1",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.121",
    "ai": "7.0.176",
    "chrono-node": "2.10.3",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  }
}
