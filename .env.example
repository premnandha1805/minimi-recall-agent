# Copy to .env only for a fresh checkout. Keep an existing valid .env.
# The server and conversation routes start without provider credentials.
# For live chat, uncomment MODEL_PROVIDER and fill every Azure/Tavily field.
# Never commit .env. Existing process variables win; restart after editing.

PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DEFAULT_TIMEZONE=Asia/Kolkata

# Azure OpenAI v1 text chat with function tools and max_completion_tokens.
# No deployment, context capacity, student eligibility or free quota is assumed.
# MODEL_PROVIDER=azure-openai-v1
AZURE_OPENAI_CHAT_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_CONTEXT_TOKENS=
TAVILY_API_KEY=
# Endpoint shape: https://YOUR-RESOURCE.openai.azure.com/openai/v1/chat/completions
# Set the actual deployment context window, not a guessed model limit.

# Optional settings; paths resolve relative to this project, not the shell cwd.
# MEMORY_DIRECTORY=.data/conversations
# LOG_LEVEL=info
# MAX_BODY_BYTES=262144
# REQUEST_DEADLINE_MS=25000
# Debug memory metadata endpoint is local/same-origin only.
# In production it is disabled unless DEBUG_MEMORY=1. It does not enable text logs.
# DEBUG_MEMORY=0