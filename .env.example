# Server Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to source control.

# Server settings
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Model Provider configuration
# Supported providers (via model adapter): groq, gemini, openrouter, openai, anthropic
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash
# Set the corresponding API key for your chosen provider
GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Web Search Provider (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Timezone for relative date resolution (chrono-node)
DEFAULT_TIMEZONE=Asia/Kolkata

