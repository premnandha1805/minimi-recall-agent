# Server Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to source control.

# Server settings
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# LOG_LEVEL=info
# MAX_BODY_BYTES=262144
# REQUEST_DEADLINE_MS=25000
# One private archive directory, resolved independently of the launching cwd.
# Default: <project>/.data/conversations (per-conversation atomic JSON files).
# Existing .recall-data archives are copied once at startup; originals are retained.
# MEMORY_DIRECTORY=D:/Minimi Recall Agent/.data/conversations
# Debug summary is local/same-origin only; production requires DEBUG_MEMORY=1.
# DEBUG_MEMORY=0

# Model Provider configuration
# Existing provider selections are reserved; this feature implements only azure-openai-v1.
# /api/chat requires azure-openai-v1 and Tavily configuration; otherwise HTTP 503.
# The Gemini defaults below allow startup only, NOT working chat.
# For the interview demo, select Azure and fill every required Azure field below.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash
# Reserved provider keys do not enable HTTP chat in this implementation.
GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for HTTP chat: Azure OpenAI v1 Chat Completions ONLY.
# Confirm your deployment supports text, system messages, function tools and
# max_completion_tokens. Check eligibility/quota yourself; no billing is enabled here.
# MODEL_PROVIDER=azure-openai-v1
# AZURE_OPENAI_CHAT_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/chat/completions
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_CONTEXT_TOKENS=
# Set the actual deployment context window above. No model or API-version fallback.
# AZURE_OPENAI_DEPLOYMENT is used instead of MODEL_NAME for this adapter.

# Web Search Provider (Tavily)
# Backend only; optional for server startup. One basic search per admitted query.
# Configured chat requests may search. No live calls on startup or in tests.
# See docs/web-search.md for the separate opt-in smoke command.
TAVILY_API_KEY=your_tavily_api_key_here

# Timezone for relative date resolution (chrono-node)
DEFAULT_TIMEZONE=Asia/Kolkata

